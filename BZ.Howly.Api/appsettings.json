{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Howly": ""
  },
  "Jwt": {
    "Issuer": "howly-api",
    "Audience": "howly-web",
    "SigningKey": "",
    "AccessTokenLifetime": "00:15:00",
    "RefreshTokenLifetime": "7.00:00:00"
  },
  "Auth": {
    "RefreshCookie": {
      "Name": "howly_refresh",
      "SameSite": "Strict"
    }
  },
  "RateLimiting": {
    "Login": {
      "PermitLimit": 10
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "FileStorage": {
    "RootPath": "App_Data/files"
  },
  "Tenancy": {
    "BaseDomains": [
      "localhost"
    ],
    "FallbackSlug": "",
    "CacheDuration": "00:02:00",
    "NotFoundCacheDuration": "00:00:10",
    "MaxCachedPortals": 10000
  },
  "ForwardedHeaders": {
    "TrustAllProxies": false
  }
}
